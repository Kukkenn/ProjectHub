{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProjectHub",
  "version": "1.0.0",
  "identifier": "pl.projecthub.desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "windows": [
      { "label": "main", "title": "ProjectHub", "width": 1360, "height": 860, "minWidth": 900, "minHeight": 600, "backgroundColor": "#0E0C1A" }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": ["resources/**/*"]
  }
}
